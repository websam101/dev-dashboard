# dev-dashboard environment variables
# Copy this to .env and edit as needed.
# Quasar SSR will read PORT at build time (quasar.config.ts prodPort)
# and at runtime via process.env.PORT.

# Port the SSR server listens on (default: 3000)
PORT=3000

# CORS allowed origin — only needed when accessing from a host/port
# different from the one the server runs on. Defaults to http://localhost:<PORT>.
# CORS_ORIGIN=http://192.168.1.100:3000
